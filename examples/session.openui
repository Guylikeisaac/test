root = Screens([intro, warmup, circuit, recover, finish])
intro = Screen([introTitle, introCopy, stat1, stat2, stat3, effort1, introAsk, cue1])
introTitle = Text("Neon Intervals", "title")
introCopy = Text("A fictional five-step session for an imaginary athlete. Every round is simulated — you only drive the interface.", "description")
stat1 = Metric("5", "steps")
stat2 = Metric("2:15", "simulated time")
stat3 = Metric("3", "rounds")
effort1 = Effort(6, "Simulated intensity")
introAsk = FollowUps(["Let's go", "Make it lighter", "Make it harder"])
cue1 = Cue("Welcome in. Tonight's session is pure fiction — five screens, three rounds. Tap Let's go when you're ready.")
warmup = Screen([warmTitle, warmCopy, warmTimer, cue2])
warmTitle = Text("Round 1 · Orbit Warm-up", "title")
warmCopy = Text("Fictional move: three slow orbits around an imaginary moon. Nothing to do here but watch the clock.", "description")
warmTimer = Timer("Orbit warm-up", 45)
cue2 = Cue("Orbit warm-up is queued. Start the simulated clock whenever you like.")
circuit = Screen([circuitTitle, moves, circuitTimer, effort2, cue3])
circuitTitle = Text("Round 2 · Comet Circuit", "title")
moves = List([move1, move2, move3])
move1 = ListItem("Comet Drift — a made-up glide across the starfield", "numbered")
move2 = ListItem("Nebula Hold — an imaginary pause in zero gravity", "numbered")
move3 = ListItem("Solar Flare — a fictional finisher, purely on screen", "numbered")
circuitTimer = Timer("Comet circuit", 60)
effort2 = Effort(7, "Round intensity")
cue3 = Cue("Comet Circuit. Three fictional moves, one simulated minute. You've got this.")
recover = Screen([recoverFigure, recoverTimer, recoverNote, cue4])
recoverFigure = Keyword("30", "seconds of simulated recovery")
recoverTimer = Timer("Recovery", 30)
recoverNote = Alert("info", "Recovery is simulated too. Breathe normally and enjoy the quiet.")
cue4 = Cue("Recovery window. Nothing to do — the clock runs down on its own.")
finish = Screen([finishTitle, done1, done2, done3, finishCopy, finishAsk, cue5])
finishTitle = Text("Session complete", "title")
done1 = Metric("3", "rounds cleared")
done2 = Metric("2:15", "simulated time")
done3 = Metric("+120", "fictional XP")
finishCopy = Text("Nice work steering the session. None of this tracked real activity.", "body")
finishAsk = FollowUps(["Run it back"])
cue5 = Cue("That's a wrap on Neon Intervals. Run it back any time.")
